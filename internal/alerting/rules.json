{
  "apiVersion": "monitoring.job/v1alpha1",
  "kind": "AlertRules",
  "metadata": { "name": "default", "version": 1, "checksum": "7b9de728731ffd89bd1ef8c6ad09d1afeea4fe30cb534067b9bdc560f8afea4b" },
  "spec": {
    "rules": [
      {
        "id": "run-stuck-default",
        "enabled": true,
        "priority": 0,
        "source": "ANNOTATION",
        "annotationType": "RUN_STUCK",
        "alertType": "RUN_STUCK",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "run-lost-default",
        "enabled": true,
        "priority": 0,
        "source": "ANNOTATION",
        "annotationType": "RUN_LOST",
        "alertType": "RUN_LOST",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "run-duplicate-default",
        "enabled": true,
        "priority": 0,
        "source": "ANNOTATION",
        "annotationType": "RUN_DUPLICATE_SUSPECTED",
        "alertType": "RUN_DUPLICATE_SUSPECTED",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "schedule-missed-default",
        "enabled": true,
        "priority": 0,
        "source": "ANNOTATION",
        "annotationType": "SCHEDULE_MISSED",
        "alertType": "SCHEDULE_MISSED",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "queue-backlog-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "queue.pending_count",
        "operator": "GT",
        "threshold": 20,
        "alertType": "QUEUE_BACKLOG",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "worker-offline-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "worker.heartbeat_age",
        "operator": "GT",
        "threshold": 60,
        "alertType": "WORKER_OFFLINE",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "queue-no-consumer-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "queue.consumer_count",
        "operator": "EQ",
        "textValue": "0",
        "alertType": "QUEUE_NO_CONSUMER",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "queue-age-high-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "queue.oldest_age",
        "operator": "GT",
        "threshold": 300,
        "alertType": "QUEUE_AGE_HIGH",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "pii-policy-violated",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "pii.policy_action",
        "operator": "EQ",
        "textValue": "BLOCK",
        "alertType": "PII_POLICY_VIOLATED",
        "severity": "CRITICAL",
        "scope": { "type": "PII_CATEGORY", "values": ["SSN", "CreditCard"] }
      },
      {
        "id": "run-failed-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "run.failed_age",
        "operator": "LTE",
        "threshold": 900,
        "alertType": "RUN_FAILED",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "run-retry-exhausted-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "run.retries_exhausted_age",
        "operator": "LTE",
        "threshold": 900,
        "alertType": "RUN_RETRY_EXHAUSTED",
        "severity": "CRITICAL",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "run-timeout-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "run.timed_out_age",
        "operator": "LTE",
        "threshold": 900,
        "alertType": "RUN_TIMEOUT",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "pii-scan-failed-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "pii.scan_failed_age",
        "operator": "LTE",
        "threshold": 900,
        "alertType": "PII_SCAN_FAILED",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "schedule-delayed-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "schedule.creation_lateness",
        "operator": "GT",
        "threshold": 30,
        "alertType": "SCHEDULE_DELAYED",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "monitoring-gap-default",
        "enabled": true,
        "priority": 0,
        "source": "METRIC",
        "metric": "monitoring.status",
        "operator": "NEQ",
        "textValue": "COMPLETE",
        "alertType": "MONITORING_GAP",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "worker-capacity-high-default",
        "enabled": false,
        "priority": 0,
        "source": "METRIC",
        "metric": "worker.capacity_used",
        "operator": "GT",
        "threshold": 90,
        "alertType": "WORKER_CAPACITY_HIGH",
        "severity": "WARNING",
        "scope": { "type": "GLOBAL" }
      },
      {
        "id": "pii-detected-default",
        "enabled": false,
        "priority": 0,
        "source": "METRIC",
        "metric": "pii.policy_action",
        "operator": "NEQ",
        "textValue": "BLOCK",
        "alertType": "PII_DETECTED",
        "severity": "INFO",
        "scope": { "type": "GLOBAL" }
      }
    ]
  }
}